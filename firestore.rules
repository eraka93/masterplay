rules_version = '2';

// See docs/ARCHITECTURE.md ("Firestore data model") for the full rationale. In short:
//   - All user-generated data lives under users/{uid}/... so ownership is a single check.
//   - There is no shared/public content in Firestore at all: lessons, quizzes, challenges and
//     the knowledge base are static, versioned with the app bundle (src/data/content), not
//     stored server-side — so there is nothing here for "public learning content" to protect.
//   - Nothing is ever readable or writable by anyone other than its owner. This is a personal
//     app; there is no multi-user sharing surface to design rules for.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Covers every per-user subcollection in one rule: profile/main, activities/*, goals/*,
      // notes/*, bookmarks/*, quizAttempts/*, challengeAttempts/*, realWorldProblems/*,
      // engineeringDecisions/*, userAchievements/*, reviewSchedule/*, notificationTokens/*
      // (see repositories/index.ts).
      match /{collection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
